      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT action as client_source, COUNT(*) as count FROM user_activities WHERE action IN ('chat_query', 'search_notes', 'vector_search', 'hybrid_search', 'instant_search', 'rag_search', 'upload_file', 'upload_screenshot', 'create_quick_note') AND created_at >= NOW() - INTERVAL '7 days' GROUP BY action ORDER BY count DESC",
          "refId": "A"
        }
      ],
      "title": "Activity Distribution",
      "description": "Distribution of activities by action type including searches and uploads.",
      "type": "piechart"
    },
    {
      "collapsed": false,
