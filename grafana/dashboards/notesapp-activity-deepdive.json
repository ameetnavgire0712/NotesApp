          "rawSql": "SELECT COUNT(*) as value FROM user_activities WHERE action IN ('chat_query', 'search_notes', 'vector_search', 'hybrid_search', 'instant_search', 'rag_search', 'upload_file', 'upload_screenshot', 'create_quick_note') AND created_at >= NOW() - INTERVAL '24 hours'",
