                  "steps": [
                    { "color": "green", "value": null }, 
                    { "color": "yellow", "value": 2000 }, 
                    { "color": "red", "value": 5000 }
                  ] 
                } 
              },
              { "id": "max", "value": 8000 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "correlation_id" },
            "properties": [
              { "id": "custom.width", "value": 320 },
              { "id": "links", "value": [
                {
                  "title": "📋 View Detailed Logs (HTML Viewer)",
                  "url": "https://notesapp-search.fly.dev/logs?correlation_id=${__value.text}",
                  "targetBlank": true
                }
              ] }
            ]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 9 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "created_at" }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT TO_CHAR(ua.created_at, 'YYYY-MM-DD HH24:MI:SS') as created_at, ua.user_id, SUBSTRING(COALESCE(ua.metadata->>'query', ua.metadata->>'message', ua.metadata->>'filename', ua.metadata->>'title', '(no details)') FROM 1 FOR 80) as query_preview, ua.action as client_source, ua.status, ua.duration_ms, ua.correlation_id::text as correlation_id FROM user_activities ua WHERE ua.action IN ('chat_query', 'search_notes', 'vector_search', 'hybrid_search', 'instant_search', 'rag_search', 'upload_file', 'upload_screenshot', 'create_quick_note') AND ('$user_id' = 'All' OR '$user_id' = '$__all' OR ua.user_id = '$user_id') ORDER BY ua.created_at DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Activity Details",
      "description": "Click on the correlation_id to view detailed logs for any activity (search or upload), including timing breakdowns.",
      "type": "table"
    },
