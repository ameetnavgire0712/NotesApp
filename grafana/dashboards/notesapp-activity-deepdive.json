      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "created_at" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "user_id" },
            "properties": [
              { "id": "custom.width", "value": 280 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "query_preview" },
            "properties": [
              { "id": "custom.width", "value": 300 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "client_source" },
            "properties": [
              { "id": "custom.width", "value": 140 },
              { "id": "mappings", "value": [
                { "options": { 
                    "chat_query": { "color": "purple", "index": 0, "text": "💬 Chat" }, 
                    "search_notes": { "color": "blue", "index": 1, "text": "🔍 Search" }, 
                    "instant_search": { "color": "green", "index": 2, "text": "⚡ Instant" },
                    "hybrid_search": { "color": "orange", "index": 3, "text": "🔀 Hybrid" },
                    "vector_search": { "color": "cyan", "index": 4, "text": "📊 Vector" },
                    "rag_search": { "color": "yellow", "index": 5, "text": "🤖 RAG" },
                    "upload_file": { "color": "semi-dark-blue", "index": 6, "text": "📁 File Upload" },
                    "upload_screenshot": { "color": "semi-dark-purple", "index": 7, "text": "📸 Screenshot" },
                    "create_quick_note": { "color": "semi-dark-green", "index": 8, "text": "📝 Quick Note" }
                  }, "type": "value" }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "mappings", "value": [
                { "options": { 
                    "error": { "color": "red", "index": 1, "text": "❌ Error" }, 
                    "success": { "color": "green", "index": 0, "text": "✓ Success" } 
                  }, "type": "value" }
              ] }
            ]
          },
