          "rawSql": "SELECT user_id, COUNT(*) as activity_count, COUNT(DISTINCT action) as unique_actions, MODE() WITHIN GROUP (ORDER BY action) as favorite_action, MIN(created_at) as first_activity, MAX(created_at) as last_activity FROM user_activities WHERE created_at >= NOW() - INTERVAL '30 days' AND user_id NOT IN ('system', 'unknown', 'default_user') GROUP BY user_id ORDER BY activity_count DESC LIMIT 20",
