# =============================================================================
# SecondBrain Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Blob Storage (for document storage)
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=notesapp-documents

# -----------------------------------------------------------------------------
# Supabase (database and auth)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://vnpqsmiuismvwsynpmfu.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # Service role key (backend only)
SUPABASE_ANON_KEY=eyJ...     # Anon key (for frontend auth)
SUPABASE_JWT_SECRET=your-jwt-secret

# -----------------------------------------------------------------------------
# Admin Configuration
# -----------------------------------------------------------------------------
ADMIN_USER_ID=your-admin-user-uuid

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------
TENSORLAKE_API_KEY=your-tensorlake-key
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...  # Optional, for fast inference

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Frontend URL (Cloudflare Pages in production)
FRONTEND_URL=https://secondbrain.pages.dev

# Backend API URL (Fly.io in production)  
API_BASE_URL=https://notesapp-search.fly.dev

# -----------------------------------------------------------------------------
# CORS Configuration (IMPORTANT for security)
# -----------------------------------------------------------------------------
# Development: Use "*" to allow all origins
# Production: Comma-separated list of allowed origins
# Example: "https://secondbrain.pages.dev,https://app.secondbrain.com"
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
USE_LOCAL_EMBEDDINGS=true      # Use BGE embeddings (faster, free)
USE_SEMANTIC_CHUNKING=true     # Use Docling for smart chunking
USE_RERANKER=true              # Use cross-encoder reranking

# -----------------------------------------------------------------------------
# Cloudflare Vectorize (optional - for production vector search)
# -----------------------------------------------------------------------------
VECTORIZE_WORKER_URL=https://notesapp-vector-search.your-subdomain.workers.dev
VECTORIZE_WORKER_API_KEY=your-worker-api-key
VECTORIZE_INDEX_NAME=notesapp-vectors
